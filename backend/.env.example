# ---- Required ----
MONGO_URI=mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/news?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string

# ---- Admin seed (created on first boot) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Limits ----
ANON_LIMIT=2
USER_DAILY_LIMIT=2

# ---- Optional: scaling / restricted videos ----
# Proxies to dodge YouTube's IP block. Either one:
#   YTDLP_PROXY=http://user:pass@host:port
# or a comma-separated list (the app rotates, trying each until one works):
#   YTDLP_PROXIES=http://user:pass@ip1:port1,http://user:pass@ip2:port2,...
YTDLP_PROXY=
YTDLP_PROXIES=
# Path to a cookies.txt for age-restricted/members videos:
YTDLP_COOKIES=
